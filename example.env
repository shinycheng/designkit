# DesignKit 部署配置模板（配合 docker-compose.yml 使用）
#
# 用法：把本文件改名为 .env，按下面的提示改几个值，然后 docker compose up -d
# 本机开发用的常用配置项见 .env.example，这里只列部署必须关心的。
#
# 改完这个文件想生效，一律用 `docker compose up -d`，不要用 `restart`——
# restart 不会重新读取本文件。

# ---------------------------------------------------------------- 必填

# 数据库密码。随便写一个长一点的，可以带特殊符号，应用侧会正确转义。
#
# ⚠️ 这个密码只在**第一次启动**时写进数据库。第一次启动之后千万不要再改这里：
# 数据库里的密码不会跟着变，应用却会拿新密码去连，结果是应用连不上库、
# 页面一直转圈。确实要换密码，得先进数据库容器改，再同步改这里。
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- 存放位置

# 商品原图与生成图存在 NAS 的哪里。
# 群晖建议写绝对路径，例如 /volume1/docker/designkit/data
#
# ⚠️ 备份时要备**整个目录**，不能只挑里面的图片文件夹：这个目录里还有两个隐藏文件，
# 少了哪一个恢复出来的系统都是坏的（而且都不会报错，只会表现成莫名其妙的故障）：
#
#   .secret_key —— 签发登录令牌和 ERP 回调签名的主密钥。
#                  丢了：所有人要重新登录；已经发给 ERP 对接方的
#                  Webhook Secret 全部作废，对方一路验签失败还查不出原因。
#   .enc_key    —— 解开成员个人网关 Key 的钥匙。
#                  丢了：全体成员突然都不能生图，而数据库看起来完好、
#                  界面上还写着「已配置 Key」。只能到网关后台把每个人的 Key
#                  重新抄一遍再逐个填回去。
#
# 另外数据库不在这里（在 Docker 数据卷里），要用 pg_dump 单独备。
# 完整备份与恢复步骤见 README「六、数据在哪里 / 怎么备份」。
DESIGNKIT_DATA_LOCATION=./data

# 上面这个目录的属主 uid/gid。在 NAS 上执行 `id` 就能看到，群晖常见 1026 和 100。
# 填对了容器会自动把目录属主纠正过来，你不用手工 chown；填错了通常是你在
# File Station 里打不开生成的图。
# 注意：请给 DesignKit 单独建一个空目录。目录里若混有别的文件，容器出于安全
# 考虑不会去改属主，只在启动日志里打印 [entrypoint] 警告。
PUID=1026
PGID=100

# ---------------------------------------------------------------- 访问方式

# 监听地址：0.0.0.0 表示同局域网的电脑、手机、ERP 都能访问。
# ⚠️ 不要把这个端口转发到公网——当前是 HTTP 明文，登录密码会裸奔。
DESIGNKIT_BIND_HOST=0.0.0.0
DESIGNKIT_HOST_PORT=8787

# 对外访问地址，换成 NAS 的实际 IP。
# 只影响对外 API 和回调里的图片绝对链接；网页端用相对路径，不受影响。
DESIGNKIT_PUBLIC_BASE_URL=http://192.168.31.100:8787

# ---------------------------------------------------------------- 生图网关

# mock=模拟生图（不花钱，用来先跑通流程）；openai=真实调用。
# 默认是 openai，所以下面的 Key 没填之前，第一次点生成会报「尚未配置生图 API Key」。
# 想先零成本跑通整个流程，把这里改成 mock。
DESIGNKIT_PROVIDER=openai

# 你的自建网关地址。注意 NAS 必须能连到这台机器。
OPENAI_BASE_URL=http://192.168.31.235:8090/v1

# 网关 Key —— 建议留空，启动后在网页「系统设置 → 生图服务」里填。
# 写在这里的话，任何能看到这个文件的人都能拿走你的 Key。
#
# 这是**全局兜底 Key**：默认情况下全公司共用它，所有人的生图费用记在一起；
# ERP 对外接口用的也是这一把。
# 想让每个成员各花各的钱，成员的 Key 是在网页「成员账号」页**逐个配置**的，
# 不写在这个文件里（配好之后还要把下面的 DESIGNKIT_GATEWAY_MODE 改成 per_user，
# 或者在网页「系统设置 → 图片访问与多用户」里改）。详见 README 第七章。
OPENAI_API_KEY=

# 「自动开通生图额度」（系统自动去 Sub2API 网关替每个新成员建号、领 Key）
# **一项都不在这个文件里配**，全部在网页「系统设置 → 网关自动开通」里填：
# 网关后台地址、网关管理员 Key、目标分组 id、成员邮箱后缀。默认是关闭的。
# 为什么不放这里：管理员 Key 是整台网关的最高权限，本项目的规矩是密钥一律由你
# 自己在网页界面填，不落任何配置文件；其余几项是跟着这台实例走的一次性配置，
# 放进 .env 只会多出「env 填了、库里也存了，到底哪个生效」的困惑。
# 怎么配、怎么测、开不通了怎么办，见 docs/auto-provision.md。

DESIGNKIT_IMAGE_MODEL=gpt-image-2

# 出图底色：auto=跟随模型（通常是实色底）；transparent=要求输出透明底 PNG（免抠图）。
# 选 transparent 需要你的网关支持 background 参数：多数网关不支持时会直接报错，
# 但也有网关会静默忽略、照常出实底图，第一次用请先出 1 张确认。
# 也可以启动后在网页「系统设置 → 生图服务」里改。
DESIGNKIT_IMAGE_BACKGROUND=auto
DESIGNKIT_TEXT_MODEL=gpt-5.6-sol

# ---------------------------------------------------------- 多用户与图片访问
#
# 下面这一段（到 DESIGNKIT_ALLOWED_ORIGINS 为止）**都有合适的默认值，
# 第一次部署可以一行都不动**。
# 这 5 项同时也是网页「系统设置 → 图片访问与多用户」里的几个开关，
# 而且**网页里的设置优先**：只要有人在网页上保存过那一节，这里再怎么改都不会生效
# （数据库里存了值就以数据库为准）。所以这几行的真正用途只有一个——
# 让全新部署一起来就是你要的样子。日常调整请到网页里改。
#
# 注意：再往下的 DESIGNKIT_ENCRYPTION_KEY 不属于这一段，它另有一节，规则也不一样。

# 生图费用怎么算：
#   shared   = 全公司共用上面那把全局 Key，费用记在一起（默认）
#   per_user = 每人一把自己的 Key，各花各的，账单分得清是谁用的
#
# ⚠️ 改成 per_user 之前，必须先在网页「成员账号」页给每个成员都配好 Key，
# 否则没配 Key 的人一点生成就被拦住（任务直接失败，提示他找管理员开通）。
# 管理员自己没配个人 Key 时仍然用全局那把。模拟生图模式（mock）不受影响。
DESIGNKIT_GATEWAY_MODE=shared

# 图片链接要不要凭证才能打开。默认 true，也就是「没凭证就不给看」。
#   网页端：登录时自动下发一个只对 /files 生效的 Cookie，用户无感
#   对接方：链接里带 ?k=&e=&t= 签名参数
# 改成 false 会退回「知道地址就能下载任何人的图」的老行为，
# 只在对接方一时半会儿换不完老链接时临时用，别长期开着。
DESIGNKIT_FILES_SIGNED_ONLY=true

# 网页端取图凭证的有效期（天），范围 7–30。到期重新登录一次即可。
DESIGNKIT_WEB_FILE_COOKIE_DAYS=7

# 给 ERP 的图片链接有效多久（小时），范围 1–8760。默认 168 小时 = 7 天。
# 对接方要长期留存图片的话，让他改用「凭 API Key 直接取图」那条端点，
# 见 docs/erp-api.md 的 3.6 节。
DESIGNKIT_ERP_FILE_LINK_TTL_HOURS=168

# 允许哪些网站的网页调用本系统接口（CORS）。* = 不限制（默认，与以前一致）。
# 多个用英文逗号隔开，每一条都要带 http:// 或 https:// 且不带路径。
# ⚠️ 这一项改完**必须重启服务**（docker compose up -d）才生效。
# ⚠️ 部署到公网时把它改成你自己的域名，别留 *。
DESIGNKIT_ALLOWED_ORIGINS=*

# 允不允许「对外接口里填的地址」指向内网/本机。默认 true。
#   true  = 允许。内部部署时 ERP 常在内网，要让本系统去内网取图，所以默认开着
#   false = 拒绝。指向内网、本机的取图地址和回调地址一律拦下
#
# 这一项只管**别人在对外接口里填的地址**（image_urls 取图、callback_url 回调），
# 不管你自己在网页里填的生图网关地址——网关在内网照样连得上，改成 false 也不影响生图。
#
# ⚠️ 想开放「自助注册」就必须把它改成 false，系统会强制要求（改不了就存不进去）。
# 道理：这两个地址是由**服务端**去访问的，允许内网时它们可以指向你内网里的任何东西
#（包括生图网关的管理后台，那上面能建号、改余额、读别人的明文 Key）。
# 今天拿得到对外接口 Key 的只有管理员，所以这条链是断的；强制关闭是因为「断」得太脆弱——
# 那只是代码里的一行判断，也可能是你把 Key 发给了某个外部对接方。
# 开放注册＝你不再认识系统里的每一个人，这时候该把这道门锁死，而不是指望别处不出错。
# 详见 README 第八章 8.1。云服务商的元数据地址（169.254.x）无论这里怎么填都一直拦着。
DESIGNKIT_ALLOW_INTERNAL_TARGETS=true

# 前面隔着几层反向代理 / CDN。默认 0 = 没有反代，直接按 TCP 连接的对端地址算。
#   0 = 浏览器直连本服务的端口（默认）
#   1 = 前面有一层 Nginx / Caddy / 群晖自带反向代理
#   2 = 再前面还有一层 CDN（如 Cloudflare）
#
# 这一项决定登录限速、注册限速看到的是谁的 IP，配错的后果不对称，宁小勿大：
#   填小了 → 所有人共用一个限速桶（严一点，但没有安全问题）
#   填大了 → 系统会去信客户端自己伪造的那一段地址，限速当场作废
# 套了反代却填 0 的表现是：一个人被限速，全公司都登不上。
DESIGNKIT_TRUSTED_PROXY_HOPS=0

# ------------------------------------------------ 关于「自助注册（邀请码）」
#
# 自助注册那一组设置（总开关、单 IP 每小时上限、全站每日上限、邀请码的两个默认值）
# **故意一个环境变量都不提供**，只能在网页里改。
#
# 理由：总开关是一道安全闸门，打开它之前系统要先确认三件事
#（内网访问已关闭、对外访问地址真的能打开、图片凭证已开启）。
# 留一个 .env 后备，等于留了一条**绕过这些检查**把注册打开的路，
# 而且是那种「谁也想不起来自己什么时候设过这个变量」的路。
#
# 怎么打开见 README 第八章 8.2。默认是关着的，不打开的话行为和以前完全一样。

# ------------------------------------------------ 凭据加密钥匙（不是网页开关）
#
# 这一项和上面那几行不一样：它**不在网页设置里**，网页上改不了，
# 也不会被数据库里的设置覆盖。程序只在**启动时读一次**，
# 所以在这里填了就一定算数（改完要 docker compose up -d 才生效）。

# 凭据加密的主密钥（用来加密成员的个人网关 Key）。
# **留空就好**：不填的话程序会自动生成 data/.enc_key 并妥善保管，这是推荐做法。
#
# 只有一种情况需要填：多台机器共用同一个数据库、但各自有独立的 data 目录——
# 那时必须让它们用同一把钥匙，否则 A 机器加密的 Key，B 机器解不开。
# 填的话至少 16 位，太短程序会拒绝启动。生成一串随机的：
#     python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#
# ⚠️ 一旦填了并且已经存过成员的 Key，就**再也不能改**——改了等于所有成员的
# 网关 Key 永久解不开（表现是全体突然都不能生图，而数据库看起来完好无损）。
# 同理，如果填了它，那么备份时要备的是这个 .env 文件，data/.enc_key 不再起作用。
# DESIGNKIT_ENCRYPTION_KEY=

# ---------------------------------------------------------------- 一般不用改

POSTGRES_DB=designkit
POSTGRES_USER=designkit

# 镜像版本。latest = 永远跟随最新。
#
# ⚠️ 每次升级之前，请先把这里从 latest 改成「当前正在跑的那一版」并抄在纸上，
# 否则新版本出问题时，你说不清楚该退回哪一版——latest 今天指向的东西和上周不是
# 一回事。查当前版本（在放着本文件的目录里执行）：
#
#     sudo docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' designkit | cut -c1-7
#
# 打印出来是 7 位字符（例如 6ca035d），前面加 sha- 填到下面，即 sha-6ca035d。
# 每次推送代码 GitHub 都会自动打一个 sha- 开头的标签，所以任何一版都能这样退回去。
# 详细步骤见 docs/deploy-synology.md「以后怎么更新」。
DESIGNKIT_VERSION=latest

# 灵感库自动同步（上游每天更新两次，12 小时正好对齐）
# 同步灵感库要访问 GitHub，部分地区直连不通时填代理（也可在网页设置里改）。
# 只影响灵感库同步；生图网关是局域网地址，永远直连。
DESIGNKIT_INSPIRATION_PROXY=

DESIGNKIT_INSPIRATION_AUTO_SYNC=true
DESIGNKIT_INSPIRATION_SYNC_INTERVAL_HOURS=12
