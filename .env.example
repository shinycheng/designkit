# 复制此文件为 .env 可用环境变量做初始配置（也可以直接在网页「系统设置」里配置，网页配置优先）

# 生图服务：mock=模拟生图（不花钱）；openai=OpenAI 兼容接口（官方或国内中转平台）
DESIGNKIT_PROVIDER=mock

# 国内中转平台给你的接口地址与 Key（OpenAI 兼容格式）
OPENAI_BASE_URL=http://192.168.31.235:8090/v1
OPENAI_API_KEY=

# 发送前按所选比例预处理商品图（补边/合白底/HEIC转码），默认开启
DESIGNKIT_NORMALIZE_INPUT_RATIO=true

# AI 现场写提示词用的文本模型（需支持看图）与开关
DESIGNKIT_TEXT_MODEL=gpt-5.6-sol
DESIGNKIT_PROMPT_SYNTHESIS=true

# 生图模型名称
DESIGNKIT_IMAGE_MODEL=gpt-image-2

# 服务监听地址与端口
DESIGNKIT_HOST=127.0.0.1
DESIGNKIT_PORT=8787

# 对外访问地址（仅对外 API 和回调用它拼绝对链接；网页端用相对路径不受影响）
# 部署服务器后改成服务器地址，如 http://服务器IP:8787
DESIGNKIT_PUBLIC_BASE_URL=http://127.0.0.1:8787

# 数据目录（数据库+图片都存这里，默认项目下的 data/），一般不用改
# DESIGNKIT_DATA_DIR=/绝对路径/data

# 主密钥（不填会自动生成并存到数据目录；多机部署需固定同一个值）
# DESIGNKIT_SECRET_KEY=
