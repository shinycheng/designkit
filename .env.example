# 复制此文件为 .env 可用环境变量做初始配置（也可以直接在网页「系统设置」里配置，网页配置优先）
#
# 这里列的是本机开发常用的项，不是全部——并发数、重试次数、请求超时、是否允许内网地址
# 等都在网页「系统设置」里改，不必写进这个文件。
# 服务器 / NAS 部署请改用 example.env（那份是按部署场景裁剪的）。

# 生图服务：mock=模拟生图（不花钱）；openai=OpenAI 兼容接口（官方或国内中转平台）
DESIGNKIT_PROVIDER=mock

# 国内中转平台给你的接口地址与 Key（OpenAI 兼容格式）
#
# OPENAI_API_KEY 是**全局兜底 Key**：默认全体共用它，对外 ERP 接口用的也是这一把。
# 成员各自的 Key 不写在这里——那是在网页「成员账号」页逐个配置的，
# 配好之后还要把计费方式改成「每人一把」（见下面 DESIGNKIT_GATEWAY_MODE）。
#
# 让系统自动去网关替新成员建号、领 Key 的那套配置（网关后台地址、网关管理员 Key、
# 目标分组 id 等）**也不在这个文件里**，全部在网页「系统设置 → 网关自动开通」里填，
# 默认关闭。见 docs/auto-provision.md。
OPENAI_BASE_URL=http://192.168.31.235:8090/v1
OPENAI_API_KEY=

# 发送前按所选比例预处理商品图（补边/合白底/HEIC转码），默认开启
DESIGNKIT_NORMALIZE_INPUT_RATIO=true

# AI 现场写提示词用的文本模型（需支持看图）与开关
DESIGNKIT_TEXT_MODEL=gpt-5.6-sol
DESIGNKIT_PROMPT_SYNTHESIS=true

# 生图模型名称
DESIGNKIT_IMAGE_MODEL=gpt-image-2

# 出图底色：auto=跟随模型（通常是实色底）；transparent=要求输出透明底 PNG（免抠图）。
# 选 transparent 需要你的网关支持 background 参数：多数网关不支持时会直接报错，
# 但也有网关会静默忽略、照常出实底图，第一次用请先出 1 张确认。
# 也可以启动后在网页「系统设置 → 生图服务」里改。
DESIGNKIT_IMAGE_BACKGROUND=auto

# 服务监听地址与端口
DESIGNKIT_HOST=127.0.0.1
DESIGNKIT_PORT=8787

# 对外访问地址（仅对外 API 和回调用它拼绝对链接；网页端用相对路径不受影响）
# 部署服务器后改成服务器地址，如 http://服务器IP:8787
DESIGNKIT_PUBLIC_BASE_URL=http://127.0.0.1:8787

# 数据目录（数据库+图片都存这里，默认项目下的 data/），一般不用改
# DESIGNKIT_DATA_DIR=/绝对路径/data

# 主密钥（不填会自动生成并存到数据目录；多机部署需固定同一个值）
# 登录令牌 + ERP 回调签名用，存 data/.secret_key
# DESIGNKIT_SECRET_KEY=

# 凭据加密钥匙（不填会自动生成并存到 data/.enc_key，**推荐不填**）
# 用来加密成员的个人网关 Key。和上面那把刻意分开：
# DESIGNKIT_SECRET_KEY 换了大家重新登录一次而已，这一把换了等于
# 所有成员的网关 Key 永久解不开（表现是全体突然都不能生图，数据库却看起来完好）。
# 只有「多台机器共用同一个数据库、各自有独立 data 目录」时才需要显式固定它。
# 填的话至少 16 位，太短程序会拒绝启动。生成一串随机的：
#     python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# DESIGNKIT_ENCRYPTION_KEY=

# ---- 多用户与图片访问（都有默认值，本机开发一般不用动）----
# 这几项在网页「系统设置 → 图片访问与多用户」里也能改，**且网页里的设置优先**。

# 生图费用怎么算：shared=全体共用上面那把全局 Key（默认）；per_user=每人一把自己的。
# 改成 per_user 前必须先在「成员账号」页给每个人配好 Key，否则他们一点生成就被拦住。
# 模拟生图（mock）模式不受影响，没配 Key 也照样能出占位图。
# DESIGNKIT_GATEWAY_MODE=shared

# 图片链接要不要凭证才能打开。默认 true（没凭证就 403）。
# 网页端靠登录时下发的 Cookie，对接方靠链接里的 ?k=&e=&t= 签名，正常使用都无感。
# DESIGNKIT_FILES_SIGNED_ONLY=true

# 网页取图凭证有效期（天，7–30）／对接方图片链接有效期（小时，1–8760）
# DESIGNKIT_WEB_FILE_COOKIE_DAYS=7
# DESIGNKIT_ERP_FILE_LINK_TTL_HOURS=168

# 允许哪些网站的网页调用本系统接口（CORS）。* = 不限制（默认）。
# 多个用英文逗号隔开，每条要带 http:// 或 https:// 且不带路径。
# ⚠️ 改完必须重启服务才生效。
# DESIGNKIT_ALLOWED_ORIGINS=*

# 允不允许「对外接口里填的地址」（image_urls 取图 / callback_url 回调）指向内网、本机。
# 默认 true，因为本机开发时 ERP 和取图地址常常就是 127.0.0.1。
# 只管别人在对外接口里填的地址，不管你在网页里填的生图网关地址。
# ⚠️ 要开放「自助注册」时系统会强制要求这一项为 false，理由见 README 第八章 8.1。
# DESIGNKIT_ALLOW_INTERNAL_TARGETS=true

# 前面隔着几层反向代理 / CDN（0=没有反代，默认；1=一层 Nginx/Caddy；2=CDN+反代）。
# 决定登录/注册限速看到的是谁的 IP。本机开发保持 0。
# 宁小勿大：填小了大家共用一个限速桶，填大了系统会去信客户端伪造的地址、限速作废。
# DESIGNKIT_TRUSTED_PROXY_HOPS=0

# ---- 自助注册（邀请码）----
# 这一组**故意没有环境变量**，只能在网页里改：总开关是一道安全闸门，
# 打开前系统要先确认三件事（内网访问已关、对外地址真能打开、图片凭证已开）。
# 留一个 .env 后备等于留了一条绕过检查的路。默认关闭，怎么打开见 README 第八章 8.2。

# ---- 自助注册（手机号 + 短信验证码）与短信服务 ----
# 这一组**同样一个环境变量都没有**，全部在网页「系统设置 → 短信服务（手机号注册）」
# 里填。理由和上面那组一样（总开关是安全闸门），再加一条更硬的：
# 里面有 AccessKey，而本项目的规矩是**密钥一律由你自己在网页界面填，
# 不代填、不写进代码或任何配置文件**——所以这里只有说明，没有可填的位置。
#
# 下面列出来是为了让你知道有哪些开关、默认值是多少，照着到网页里找：
#
#   sms_provider                      默认 debug
#       debug  = 调试模式，**根本不发短信**，验证码直接显示在网页上和日志里，
#                用来先把整条注册流程走通，不花一分钱
#       aliyun = 真的发、真的花钱
#       ⚠️ 忘了从 debug 切回 aliyun 的后果：你以为短信发出去了，
#          其实用户永远收不到，双方都查不出问题在哪。网页上会显著标出当前模式。
#   sms_aliyun_access_key_id          默认空（网页里填）
#   sms_aliyun_access_key_secret      默认空（网页里填；加密落库、界面上全星号）
#   sms_aliyun_sign_name              默认空——短信签名，要和阿里云审核通过的逐字一致
#   sms_aliyun_template_code          默认空——形如 SMS_123456789，正文里要有 ${code}
#   sms_aliyun_endpoint               默认 dysmsapi.aliyuncs.com，正常不用改
#       （留这一项是为了让自动化测试指到本机假上游，从而不真的发短信、不花钱）
#   phone_register_enabled            默认 false（关着，装上这个功能当天行为不变）
#   phone_register_require_invite     默认 true——手机号注册时**同时**要填邀请码。
#       关掉它意味着「任何人只要有一个能收短信的手机号就能注册进来」，
#       没有任何名单限制，关之前先想清楚。
#
#   三层限速（每条短信都花钱，所以这是上线前提，不是可选的调优项）。
#   第一层「按手机号」分成冷却和每日两项，所以一共是四个数字：
#   sms_code_resend_cooldown_seconds  默认 60   ①同一手机号两次发送至少隔 60 秒
#   sms_code_phone_daily_limit        默认 10   ①同一手机号一天最多收 10 条
#   sms_code_ip_hourly_limit          默认 20   ②同一来源 IP 每小时最多 20 条
#   sms_code_global_daily_limit       默认 200  ③全站一天最多 200 条（最后一道兜底）
#
#   验证码本身（这两项不花钱，是防猜的）：
#   sms_code_ttl_seconds              默认 300  验证码 5 分钟内有效
#   sms_code_max_attempts             默认 5    一条码最多试错 5 次，超了当场作废
#
# ⚠️ 为什么限速这么要紧：被刷了不只是花钱（国内短信约 4 分/条），
#    真正的代价是阿里云会以「疑似恶意」为由**把你的签名封掉**——
#    那时候整条手机号注册通道直接停摆，重新申请签名要按工作日算。
#    发现异常（阿里云控制台的发送量、账单或告警短信；或者陌生人反映
#    「莫名其妙收到你们的验证码」）时的紧急处置：到网页设置里把 sms_provider
#    改回 debug，或者直接把手机号注册总开关关掉，注册页立刻发不出真实短信了；
#    已经注册进来的人不受影响。（设置页上那个「试发一条」按钮是例外，
#    它在调试模式下也照样真发——那是你自己点一下发一条，不是被人刷的通道。）
#    在本文件里改任何东西都救不了火——这一组不读环境变量。
#
# ⚠️ 上面提到的 DESIGNKIT_TRUSTED_PROXY_HOPS 对这里的「同一来源 IP 每小时」
#    这一层是决定性的：套了反代却填 0，全站会共用同一个桶。

# 数据库：本机留空即用 SQLite（零安装）。
# docker compose 部署时必须设置 POSTGRES_PASSWORD，不设置数据库容器会拒绝启动
# （防止默认弱口令上生产）。库名和用户名不填会自动用 designkit，一般不用改。
# 密码可以随便用特殊字符，应用侧会正确转义。
# POSTGRES_PASSWORD=换成你自己的强密码
# POSTGRES_DB=designkit
# POSTGRES_USER=designkit

# 不用 compose、连外部 PG 时用这一组（或直接给完整连接串 DESIGNKIT_DATABASE_URL）
# DESIGNKIT_DB_HOST=127.0.0.1
# DESIGNKIT_DB_PORT=5432
# DESIGNKIT_DB_NAME=designkit
# DESIGNKIT_DB_USER=designkit
# DESIGNKIT_DB_PASSWORD=你的密码

# 灵感库自动同步（上游每天更新两次，12 小时正好对齐）
# 同步灵感库要访问 GitHub，部分地区直连不通时填代理（也可在网页设置里改）。
# 只影响灵感库同步；生图网关是局域网地址，永远直连。
DESIGNKIT_INSPIRATION_PROXY=

DESIGNKIT_INSPIRATION_AUTO_SYNC=true
DESIGNKIT_INSPIRATION_SYNC_INTERVAL_HOURS=12

# ---- NAS / 服务器部署（docker compose）----
# 监听地址：默认 0.0.0.0，让同局域网的电脑和 ERP 都能访问。
# 该机器切勿把 8787 端口转发到公网（密码会明文传输）。
# DESIGNKIT_BIND_HOST=0.0.0.0
# DESIGNKIT_HOST_PORT=8787

# NAS 上 data 目录的属主 uid/gid（群晖常见 1026）。对不上会写不进图片。
# 在 NAS 上执行 `id 你的用户名` 查看
# PUID=1026
# PGID=100
